# Runtime (aplikasi) — via Supabase pooler untuk pgbouncer
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrasi / prisma migrate — koneksi langsung
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET="ganti-ini-min-32-karakter-dev-saja"
JWT_REFRESH_SECRET="ganti-ini-juga-min-32-karakter-dev-saja"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
PORT=3000
UPLOAD_DIR="./uploads"
MAX_FILE_BYTES=5000000
# local | supabase (default supabase jika URL + service role key diisi)
STORAGE_DRIVER="supabase"
# Project URL Supabase, bukan publishable key
SUPABASE_URL="https://<project-ref>.supabase.co"
# service_role/secret key hanya untuk backend; jangan pakai di frontend
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="simpeg_files"
APEL_DEADLINE_TIME="08:00"
CHECKOUT_TIME_WEEKDAY="16:00"
CHECKOUT_TIME_FRIDAY="16:30"
LETTER_UNIT_CODE="KT"
# Batas Usia Pensiun PNS (default 58 tahun)
PENSION_BUP_AGE=58
# Masa jabatan minimal dalam golongan untuk usulan kenaikan pangkat reguler
PROMOTION_MIN_YEARS=4
