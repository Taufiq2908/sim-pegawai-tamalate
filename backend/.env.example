# Runtime (aplikasi) — via Supabase pooler untuk pgbouncer
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrasi / prisma migrate — koneksi langsung
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# Koneksi pg.Pool runtime. Untuk RDS tidak ada pgbouncer.
DB_POOL_MAX=10
# disable | require | no-verify — SSL dikontrol env, bukan sslmode di URL
DATABASE_SSL="disable"
# Wajib bila DATABASE_SSL=require (CA bundle RDS, mis. /opt/simpeg/certs/rds-ca.pem)
DATABASE_SSL_CA_FILE=""
# Di production: wajib di-set, minimal 32 karakter, berbeda satu sama lain,
# dan bukan nilai placeholder di file ini. Non-production boleh default (ada warning).
JWT_ACCESS_SECRET="ganti-ini-min-32-karakter-dev-saja"
JWT_REFRESH_SECRET="ganti-ini-juga-min-32-karakter-dev-saja"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
PORT=3000
# Jumlah hop proxy yang dipercaya untuk X-Forwarded-For. Kosong = 1 di production, 0 di non-production.
# Rantai deploy: Caddy -> Next.js -> Express.
TRUST_PROXY=""
# Daftar origin CORS dipisah koma. Kosong di production = tolak semua origin lintas situs
# (request tanpa Origin dari Next.js tetap lolos).
CORS_ORIGINS=""
UPLOAD_DIR="./uploads"
# Default kode 5 MB. Produksi memakai 10 MB (sama dengan batas surat, di bawah body Caddy 12 MB).
MAX_FILE_BYTES=10000000
# local | supabase | s3 (default: supabase jika URL + service role key diisi, selain itu local)
# Wajib di-set eksplisit saat NODE_ENV=production.
STORAGE_DRIVER="supabase"
# Izinkan STORAGE_DRIVER=local di production (hanya untuk demo; file hilang saat container dibuat ulang)
ALLOW_LOCAL_STORAGE="false"
# S3 (dipakai bila STORAGE_DRIVER=s3). Kredensial dari IAM Role — jangan tulis access key.
S3_BUCKET=""
AWS_REGION="ap-southeast-3"
# Project URL Supabase, bukan publishable key
SUPABASE_URL="https://<project-ref>.supabase.co"
# service_role/secret key hanya untuk backend; jangan pakai di frontend
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="simpeg_files"
APEL_DEADLINE_TIME="08:00"
CHECKOUT_TIME_WEEKDAY="16:00"
CHECKOUT_TIME_FRIDAY="16:30"
LETTER_UNIT_CODE="KT"
# Batas Usia Pensiun PNS (default 58 tahun)
PENSION_BUP_AGE=58
# Masa jabatan minimal dalam golongan untuk usulan kenaikan pangkat reguler
PROMOTION_MIN_YEARS=4
