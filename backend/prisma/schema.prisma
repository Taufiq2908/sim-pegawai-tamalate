generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  SUPER_ADMIN
  VERIFIER
  SUPERVISOR
  LEADER
  EMPLOYEE
}

model OrganizationalUnit {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique @map("kode") @db.VarChar(20)
  name         String               @map("nama") @db.VarChar(150)
  type         String               @map("tipe") @db.VarChar(30)
  parentId     String?              @map("id_induk") @db.Uuid
  parent       OrganizationalUnit?  @relation("OrgChildren", fields: [parentId], references: [id])
  children     OrganizationalUnit[] @relation("OrgChildren")
  leaderUserId String?              @map("id_pemimpin") @db.Uuid
  isActive     Boolean              @default(true) @map("aktif")
  createdAt    DateTime             @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("diperbarui_pada") @db.Timestamptz
  employees    Employee[]
  users        User[]               @relation("UserOrg")

  @@map("unit_organisasi")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique @map("kode")
  name        String           @map("nama") @db.VarChar(100)
  description String?          @map("deskripsi")
  createdAt   DateTime         @default(now()) @map("dibuat_pada") @db.Timestamptz
  permissions RolePermission[]

  @@map("peran")
}

model Permission {
  id          String                   @id @default(uuid()) @db.Uuid
  code        String                   @unique @map("kode") @db.VarChar(60)
  resource    String                   @map("sumber_daya") @db.VarChar(30)
  action      String                   @map("aksi") @db.VarChar(30)
  description String?                  @map("deskripsi")
  roles       RolePermission[]
  overrides   UserPermissionOverride[]

  @@map("izin")
}

model RolePermission {
  roleId       String     @map("id_peran") @db.Uuid
  permissionId String     @map("id_izin") @db.Uuid
  createdAt    DateTime   @default(now()) @map("dibuat_pada") @db.Timestamptz
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("peran_izin")
}

model Employee {
  id               String             @id @default(uuid()) @db.Uuid
  nip              String?            @unique @map("nip") @db.VarChar(30)
  employeeNumber   String             @unique @map("nomor_pegawai") @db.VarChar(30)
  name             String             @map("nama") @db.VarChar(150)
  gender           String             @map("jenis_kelamin") @db.Char(1)
  birthPlace       String?            @map("tempat_lahir") @db.VarChar(100)
  birthDate        DateTime?          @map("tanggal_lahir") @db.Date
  employmentStatus String             @map("status_kepegawaian") @db.VarChar(20)
  position         String             @map("jabatan") @db.VarChar(50)
  rank             String?            @map("golongan") @db.VarChar(20)
  orgUnitId        String             @map("id_unit") @db.Uuid
  orgUnit          OrganizationalUnit @relation(fields: [orgUnitId], references: [id])
  phone            String?            @map("telepon") @db.VarChar(20)
  address          String?            @map("alamat")
  joinDate         DateTime?          @map("tanggal_masuk") @db.Date
  isActive         Boolean            @default(true) @map("aktif")
  createdAt        DateTime           @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("diperbarui_pada") @db.Timestamptz
  user             User?
  leaveRequests    LeaveRequest[]
  attendances      Attendance[]
  kgbRequests      KgbRequest[]
  warningLetters   WarningLetter[]

  @@map("pegawai")
}

model User {
  id            String                   @id @default(uuid()) @db.Uuid
  username      String                   @unique @map("nama_pengguna") @db.VarChar(50)
  passwordHash  String                   @map("hash_kata_sandi") @db.VarChar(255)
  employeeId    String?                  @unique @map("id_pegawai") @db.Uuid
  employee      Employee?                @relation(fields: [employeeId], references: [id])
  role          RoleCode                 @map("peran")
  position      String?                  @map("jabatan") @db.VarChar(50)
  orgUnitId     String?                  @map("id_unit") @db.Uuid
  orgUnit       OrganizationalUnit?      @relation("UserOrg", fields: [orgUnitId], references: [id])
  isActive      Boolean                  @default(true) @map("aktif")
  lastLoginAt   DateTime?                @map("login_terakhir_pada") @db.Timestamptz
  createdAt     DateTime                 @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt     DateTime                 @updatedAt @map("diperbarui_pada") @db.Timestamptz
  overrides     UserPermissionOverride[]
  uploadedDocs  LeaveDocument[]
  actions       LeaveApproval[]          @relation("ActorActions")
  createdLeaves LeaveRequest[]           @relation("CreatedLeaves")
  recordedAttendances Attendance[]       @relation("RecordedAttendances")
  correctedAttendances Attendance[]      @relation("CorrectedAttendances")
  createdLetters IncomingLetter[]        @relation("CreatedLetters")
  sentDispositions LetterDisposition[]   @relation("SentDispositions")
  receivedDispositions LetterDisposition[] @relation("ReceivedDispositions")
  uploadedLetterDocs LetterDocument[]
  createdKgb     KgbRequest[]           @relation("CreatedKgb")
  kgbActions     KgbApproval[]          @relation("KgbActorActions")
  uploadedKgbDocs KgbDocument[]
  createdWarnings WarningLetter[]       @relation("CreatedWarnings")
  uploadedSessionPhotos AttendanceSessionPhoto[]
  createdOutgoing OutgoingLetter[]      @relation("CreatedOutgoing")
  reservedOutgoing OutgoingLetter[]     @relation("ReservedOutgoing")
  uploadedOutgoingDocs OutgoingDocument[]
  createdExpeditions ExpeditionReceipt[] @relation("CreatedExpeditions")
  notifications Notification[]
  createdArchives ArchiveRecord[]      @relation("CreatedArchives")
  signedArchiveLists ArchiveList[]     @relation("SignedArchiveLists")
  createdArchiveLists ArchiveList[]    @relation("CreatedArchiveLists")

  @@map("pengguna")
}

model UserPermissionOverride {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("id_pengguna") @db.Uuid
  permissionId String     @map("id_izin") @db.Uuid
  effect       String     @map("efek") @db.VarChar(10)
  reason       String?    @map("alasan") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("dibuat_pada") @db.Timestamptz
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("pengguna_izin_override")
}

model LeaveType {
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @unique @map("kode") @db.VarChar(30)
  name             String         @map("nama") @db.VarChar(100)
  maxDays          Int?           @map("maks_hari")
  requiresDocument Boolean        @default(false) @map("wajib_dokumen")
  isActive         Boolean        @default(true) @map("aktif")
  requests         LeaveRequest[]

  @@map("jenis_cuti")
}

model LeaveRequest {
  id                 String          @id @default(uuid()) @db.Uuid
  requestNumber      String          @unique @map("nomor_permohonan") @db.VarChar(40)
  employeeId         String          @map("id_pegawai") @db.Uuid
  employee           Employee        @relation(fields: [employeeId], references: [id])
  leaveTypeId        String          @map("id_jenis_cuti") @db.Uuid
  leaveType          LeaveType       @relation(fields: [leaveTypeId], references: [id])
  startDate          DateTime        @map("tanggal_mulai") @db.Date
  endDate            DateTime        @map("tanggal_selesai") @db.Date
  totalDays          Int             @map("total_hari")
  reason             String          @map("alasan")
  addressDuringLeave String?         @map("alamat_selama_cuti") @db.VarChar(255)
  contactDuringLeave String?         @map("kontak_selama_cuti") @db.VarChar(30)
  status             String          @default("DRAFT") @map("status") @db.VarChar(20)
  submittedAt        DateTime?       @map("diajukan_pada") @db.Timestamptz
  currentHolderRole  String?         @map("peran_pemegang_saat_ini") @db.VarChar(20)
  rejectionReason    String?         @map("alasan_penolakan")
  revisionNote       String?         @map("catatan_revisi")
  postponeNote       String?         @map("catatan_penangguhan")
  createdBy          String          @map("dibuat_oleh") @db.Uuid
  creator            User            @relation("CreatedLeaves", fields: [createdBy], references: [id])
  createdAt          DateTime        @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("diperbarui_pada") @db.Timestamptz
  documents          LeaveDocument[]
  approvals          LeaveApproval[]

  @@index([employeeId, status])
  @@map("permohonan_cuti")
}

model LeaveDocument {
  id             String       @id @default(uuid()) @db.Uuid
  leaveRequestId String       @map("id_permohonan_cuti") @db.Uuid
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  docType        String       @map("tipe_dokumen") @db.VarChar(50)
  originalName   String       @map("nama_asli") @db.VarChar(255)
  storedPath     String       @map("jalur_simpan") @db.VarChar(500)
  mimeType       String       @map("tipe_mime") @db.VarChar(100)
  sizeBytes      Int          @map("ukuran_byte")
  uploadedBy     String       @map("diunggah_oleh") @db.Uuid
  uploader       User         @relation(fields: [uploadedBy], references: [id])
  createdAt      DateTime     @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@map("dokumen_cuti")
}

model LeaveApproval {
  id             String       @id @default(uuid()) @db.Uuid
  leaveRequestId String       @map("id_permohonan_cuti") @db.Uuid
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  actorUserId    String       @map("id_aktor") @db.Uuid
  actor          User         @relation("ActorActions", fields: [actorUserId], references: [id])
  actorRole      String       @map("peran_aktor") @db.VarChar(20)
  actorPosition  String?      @map("jabatan_aktor") @db.VarChar(50)
  actorName      String?      @map("nama_aktor") @db.VarChar(150)
  actorNip       String?      @map("nip_aktor") @db.VarChar(30)
  fromStatus     String       @map("dari_status") @db.VarChar(20)
  toStatus       String       @map("ke_status") @db.VarChar(20)
  action         String       @map("aksi") @db.VarChar(20)
  note           String?      @map("catatan")
  createdAt      DateTime     @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@index([leaveRequestId])
  @@map("persetujuan_cuti")
}

model Attendance {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("id_pegawai") @db.Uuid
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime @map("tanggal") @db.Date
  checkInAt    DateTime? @map("masuk_pada") @db.Timestamptz
  checkOutAt   DateTime? @map("pulang_pada") @db.Timestamptz
  status       String   @map("status") @db.VarChar(20)
  method       String   @map("metode") @db.VarChar(20)
  note         String?  @map("catatan")
  recordedBy   String   @map("dicatat_oleh") @db.Uuid
  recorder     User     @relation("RecordedAttendances", fields: [recordedBy], references: [id])
  correctedBy  String?  @map("dikoreksi_oleh") @db.Uuid
  corrector    User?    @relation("CorrectedAttendances", fields: [correctedBy], references: [id])
  correctedAt  DateTime? @map("dikoreksi_pada") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("diperbarui_pada") @db.Timestamptz

  @@unique([employeeId, date])
  @@index([date])
  @@map("presensi")
}

model WarningLetter {
  id               String   @id @default(uuid()) @db.Uuid
  letterNumber     String   @unique @map("nomor_surat_teguran") @db.VarChar(40)
  employeeId       String   @map("id_pegawai") @db.Uuid
  employee         Employee @relation(fields: [employeeId], references: [id])
  weekStart        DateTime @map("awal_minggu") @db.Date
  weekEnd          DateTime @map("akhir_minggu") @db.Date
  absenceCount     Int      @map("jumlah_tanpa_keterangan")
  content          String   @map("isi")
  summonScheduledAt DateTime? @map("dijadwalkan_panggilan_pada") @db.Timestamptz
  summonNote       String?  @map("catatan_panggilan")
  coachingResult    String? @map("hasil_pembinaan")
  coachingFollowUp String   @default("NONE") @map("tindak_lanjut_pembinaan") @db.VarChar(20)
  coachedAt        DateTime? @map("dibina_pada") @db.Timestamptz
  forwardBy        String?   @map("diteruskan_oleh") @db.Uuid
  forwardAt        DateTime? @map("diteruskan_pada") @db.Timestamptz
  forwardNote      String?   @map("catatan_penerusan")
  instructedBy     String?   @map("diinstruksikan_oleh") @db.Uuid
  instructedAt     DateTime? @map("diinstruksikan_pada") @db.Timestamptz
  instruction      String?   @map("instruksi")
  createdBy        String   @map("dibuat_oleh") @db.Uuid
  creator          User     @relation("CreatedWarnings", fields: [createdBy], references: [id])
  createdAt        DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@unique([employeeId, weekStart])
  @@map("surat_teguran")
}

model AttendanceSessionPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  date         DateTime @map("tanggal") @db.Date
  session      String   @map("sesi") @db.VarChar(10)
  originalName String   @map("nama_asli") @db.VarChar(255)
  storedPath   String   @map("jalur_simpan") @db.VarChar(500)
  mimeType     String   @map("tipe_mime") @db.VarChar(100)
  sizeBytes    Int      @map("ukuran_byte")
  uploadedBy   String   @map("diunggah_oleh") @db.Uuid
  uploader     User     @relation(fields: [uploadedBy], references: [id])
  createdAt    DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@unique([date, session])
  @@map("foto_apel")
}

model AttendanceLock {
  date     DateTime @id @map("tanggal") @db.Date
  lockedBy String   @map("dikunci_oleh") @db.Uuid
  note     String?  @map("catatan")
  lockedAt DateTime @default(now()) @map("dikunci_pada") @db.Timestamptz

  @@map("kunci_presensi")
}

model KgbRequest {
  id               String   @id @default(uuid()) @db.Uuid
  requestNumber    String   @unique @map("nomor_permohonan") @db.VarChar(40)
  employeeId       String   @map("id_pegawai") @db.Uuid
  employee         Employee @relation(fields: [employeeId], references: [id])
  oldRank          String   @map("golongan_lama") @db.VarChar(20)
  newRank          String   @map("golongan_baru") @db.VarChar(20)
  oldSalary        Int      @map("gaji_lama")
  newSalary        Int      @map("gaji_baru")
  effectiveDate    DateTime @map("tanggal_berlaku") @db.Date
  note             String?  @map("catatan")
  status           String   @default("DRAFT") @map("status") @db.VarChar(20)
  submittedAt      DateTime? @map("diajukan_pada") @db.Timestamptz
  currentHolderRole String?  @map("peran_pemegang_saat_ini") @db.VarChar(20)
  rejectionReason  String?  @map("alasan_penolakan")
  revisionNote     String?  @map("catatan_revisi")
  createdBy        String   @map("dibuat_oleh") @db.Uuid
  creator          User     @relation("CreatedKgb", fields: [createdBy], references: [id])
  createdAt        DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("diperbarui_pada") @db.Timestamptz
  documents        KgbDocument[]
  approvals        KgbApproval[]

  @@index([employeeId, status])
  @@map("permohonan_kgb")
}

model KgbDocument {
  id           String     @id @default(uuid()) @db.Uuid
  kgbRequestId String     @map("id_permohonan_kgb") @db.Uuid
  kgbRequest   KgbRequest @relation(fields: [kgbRequestId], references: [id], onDelete: Cascade)
  docType      String     @map("tipe_dokumen") @db.VarChar(50)
  originalName String     @map("nama_asli") @db.VarChar(255)
  storedPath   String     @map("jalur_simpan") @db.VarChar(500)
  mimeType     String     @map("tipe_mime") @db.VarChar(100)
  sizeBytes    Int        @map("ukuran_byte")
  uploadedBy   String     @map("diunggah_oleh") @db.Uuid
  uploader     User       @relation(fields: [uploadedBy], references: [id])
  createdAt    DateTime   @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@map("dokumen_kgb")
}

model KgbApproval {
  id            String     @id @default(uuid()) @db.Uuid
  kgbRequestId  String     @map("id_permohonan_kgb") @db.Uuid
  kgbRequest    KgbRequest @relation(fields: [kgbRequestId], references: [id], onDelete: Cascade)
  actorUserId   String     @map("id_aktor") @db.Uuid
  actor         User       @relation("KgbActorActions", fields: [actorUserId], references: [id])
  actorRole     String     @map("peran_aktor") @db.VarChar(20)
  actorPosition String?    @map("jabatan_aktor") @db.VarChar(50)
  fromStatus    String     @map("dari_status") @db.VarChar(20)
  toStatus      String     @map("ke_status") @db.VarChar(20)
  action        String     @map("aksi") @db.VarChar(20)
  note          String?    @map("catatan")
  createdAt     DateTime   @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@index([kgbRequestId])
  @@map("persetujuan_kgb")
}

model IncomingLetter {
  id             String   @id @default(uuid()) @db.Uuid
  agendaNumber   String   @unique @map("nomor_agenda") @db.VarChar(40)
  letterNumber   String   @map("nomor_surat") @db.VarChar(100)
  sender         String   @map("pengirim") @db.VarChar(200)
  subject        String   @map("perihal")
  summary        String?  @map("ringkasan")
  letterDate     DateTime @map("tanggal_surat") @db.Date
  receivedDate   DateTime @map("tanggal_diterima") @db.Date
  resolutionDate DateTime? @map("tanggal_penyelesaian") @db.Date
  distributedAt  DateTime? @map("didistribusikan_pada") @db.Timestamptz
  priority       String   @default("BIASA") @map("prioritas") @db.VarChar(20)
  secrecy        String   @default("B") @map("sifat") @db.VarChar(5)
  addressedTo    String?  @map("ditujukan_kepada") @db.VarChar(200)
  pic            String?  @map("penanggung_jawab") @db.VarChar(150)
  remarks        String?  @map("keterangan")
  classificationId String? @map("id_klasifikasi") @db.Uuid
  classification ArchiveClassification? @relation(fields: [classificationId], references: [id])
  status         String   @default("RECEIVED") @map("status") @db.VarChar(20)
  completionNote String?  @map("catatan_penyelesaian")
  completedAt    DateTime? @map("selesai_pada") @db.Timestamptz
  archivedAt     DateTime? @map("diarsipkan_pada") @db.Timestamptz
  createdBy      String   @map("dibuat_oleh") @db.Uuid
  creator        User     @relation("CreatedLetters", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("diperbarui_pada") @db.Timestamptz
  documents      LetterDocument[]
  dispositions   LetterDisposition[]
  expeditions    ExpeditionReceipt[]
  archiveRecord  ArchiveRecord?

  @@index([status])
  @@map("surat_masuk")
}

model LetterDisposition {
  id           String   @id @default(uuid()) @db.Uuid
  letterId     String   @map("id_surat") @db.Uuid
  letter       IncomingLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  fromUserId   String   @map("id_pengirim") @db.Uuid
  fromUser     User     @relation("SentDispositions", fields: [fromUserId], references: [id])
  toUserId     String   @map("id_penerima") @db.Uuid
  toUser       User     @relation("ReceivedDispositions", fields: [toUserId], references: [id])
  instruction  String   @map("instruksi")
  deadline     DateTime? @map("batas_waktu") @db.Date
  status       String   @default("PENDING") @map("status") @db.VarChar(20)
  responseNote String?  @map("catatan_tanggapan")
  respondedAt  DateTime? @map("ditanggapi_pada") @db.Timestamptz
  targetCode   String?  @map("kode_tujuan") @db.VarChar(30)
  targetName   String?  @map("nama_tujuan") @db.VarChar(150)
  createdAt    DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@index([letterId])
  @@map("disposisi_surat")
}

model LetterDocument {
  id           String   @id @default(uuid()) @db.Uuid
  letterId     String   @map("id_surat") @db.Uuid
  letter       IncomingLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  originalName String   @map("nama_asli") @db.VarChar(255)
  storedPath   String   @map("jalur_simpan") @db.VarChar(500)
  mimeType     String   @map("tipe_mime") @db.VarChar(100)
  sizeBytes    Int      @map("ukuran_byte")
  uploadedBy   String   @map("diunggah_oleh") @db.Uuid
  uploader     User     @relation(fields: [uploadedBy], references: [id])
  createdAt    DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@map("dokumen_surat_masuk")
}

model ArchiveClassification {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @map("kode") @db.VarChar(30)
  name      String   @map("nama") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("aktif")
  createdAt DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz
  incoming  IncomingLetter[]
  outgoing  OutgoingLetter[]
  archives  ArchiveRecord[]

  @@map("klasifikasi_arsip")
}

model DispositionTarget {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @map("kode") @db.VarChar(30)
  name      String   @map("nama") @db.VarChar(150)
  sortOrder Int      @default(0) @map("urutan")
  isActive  Boolean  @default(true) @map("aktif")

  @@map("tujuan_disposisi")
}

model OutgoingLetter {
  id               String   @id @default(uuid()) @db.Uuid
  letterNumber     String   @unique @map("nomor_surat") @db.VarChar(150)
  sequenceNumber   Int      @map("nomor_urut")
  year             Int      @map("tahun")
  classificationId String   @map("id_klasifikasi") @db.Uuid
  classification   ArchiveClassification @relation(fields: [classificationId], references: [id])
  subject          String   @map("perihal")
  recipient        String?  @map("penerima") @db.VarChar(200)
  letterDate       DateTime @map("tanggal_surat") @db.Date
  priority         String   @default("BIASA") @map("prioritas") @db.VarChar(20)
  secrecy          String   @default("B") @map("sifat") @db.VarChar(5)
  signerName       String?  @map("nama_penandatangan") @db.VarChar(150)
  status           String   @default("ISSUED") @map("status") @db.VarChar(20)
  reservationReason String? @map("alasan_reservasi")
  cancelReason     String?  @map("alasan_pembatalan")
  reservedBy       String?  @map("dipesan_oleh") @db.Uuid
  reserver         User?    @relation("ReservedOutgoing", fields: [reservedBy], references: [id])
  reservedAt       DateTime? @map("dipesan_pada") @db.Timestamptz
  issuedAt         DateTime? @map("diterbitkan_pada") @db.Timestamptz
  cancelledAt      DateTime? @map("dibatalkan_pada") @db.Timestamptz
  createdBy        String   @map("dibuat_oleh") @db.Uuid
  creator          User     @relation("CreatedOutgoing", fields: [createdBy], references: [id])
  createdAt        DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("diperbarui_pada") @db.Timestamptz
  documents        OutgoingDocument[]
  archiveRecord    ArchiveRecord?

  @@unique([year, sequenceNumber])
  @@index([status])
  @@map("surat_keluar")
}

model OutgoingDocument {
  id           String         @id @default(uuid()) @db.Uuid
  letterId     String         @map("id_surat") @db.Uuid
  letter       OutgoingLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  originalName String         @map("nama_asli") @db.VarChar(255)
  storedPath   String         @map("jalur_simpan") @db.VarChar(500)
  mimeType     String         @map("tipe_mime") @db.VarChar(100)
  sizeBytes    Int            @map("ukuran_byte")
  uploadedBy   String         @map("diunggah_oleh") @db.Uuid
  uploader     User           @relation(fields: [uploadedBy], references: [id])
  createdAt    DateTime       @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@map("dokumen_surat_keluar")
}

model ArchiveRecord {
  id               String   @id @default(uuid()) @db.Uuid
  archiveNumber    String   @unique @map("nomor_arsip") @db.VarChar(50)
  sourceType       String   @map("jenis_sumber") @db.VarChar(20)
  incomingLetterId String?  @unique @map("id_surat_masuk") @db.Uuid
  incomingLetter   IncomingLetter? @relation(fields: [incomingLetterId], references: [id], onDelete: SetNull)
  outgoingLetterId String?  @unique @map("id_surat_keluar") @db.Uuid
  outgoingLetter   OutgoingLetter? @relation(fields: [outgoingLetterId], references: [id], onDelete: SetNull)
  classificationId String?  @map("id_klasifikasi") @db.Uuid
  classification   ArchiveClassification? @relation(fields: [classificationId], references: [id])
  code             String   @map("kode_arsip") @db.VarChar(100)
  bundleCode       String?  @map("kode_berkas") @db.VarChar(100)
  title            String   @map("uraian") @db.VarChar(500)
  documentNumber   String?  @map("nomor_dokumen") @db.VarChar(150)
  documentDate     DateTime? @map("tanggal_dokumen") @db.Date
  archiveDate      DateTime @map("tanggal_arsip") @db.Date
  category         String   @default("AKTIF") @map("kategori") @db.VarChar(20)
  location         String   @default("LEMARI_ARSIP") @map("lokasi_simpan") @db.VarChar(30)
  retentionUntil   DateTime? @map("retensi_sampai") @db.Date
  notes            String?  @map("keterangan")
  listId           String?  @map("id_daftar_arsip") @db.Uuid
  list             ArchiveList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  createdBy        String   @map("dibuat_oleh") @db.Uuid
  creator          User     @relation("CreatedArchives", fields: [createdBy], references: [id])
  createdAt        DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("diperbarui_pada") @db.Timestamptz

  @@index([sourceType, category])
  @@index([listId])
  @@index([archiveDate])
  @@map("arsip")
}

model ArchiveList {
  id             String   @id @default(uuid()) @db.Uuid
  listNumber     String   @unique @map("nomor_daftar") @db.VarChar(50)
  periodStart    DateTime @map("tanggal_mulai") @db.Date
  periodEnd      DateTime @map("tanggal_akhir") @db.Date
  status         String   @default("DRAFT") @map("status") @db.VarChar(20)
  notes          String?  @map("keterangan")
  signerUserId   String?  @map("id_penandatangan") @db.Uuid
  signer         User?    @relation("SignedArchiveLists", fields: [signerUserId], references: [id])
  signerName     String?  @map("nama_penandatangan") @db.VarChar(150)
  signerNip      String?  @map("nip_penandatangan") @db.VarChar(30)
  signerPosition String?  @map("jabatan_penandatangan") @db.VarChar(50)
  signedAt       DateTime? @map("ditandatangani_pada") @db.Timestamptz
  createdBy      String   @map("dibuat_oleh") @db.Uuid
  creator        User     @relation("CreatedArchiveLists", fields: [createdBy], references: [id])
  records        ArchiveRecord[]
  createdAt      DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("diperbarui_pada") @db.Timestamptz

  @@index([status, periodStart])
  @@map("daftar_arsip")
}

model NumberingSequence {
  year       Int      @id @map("tahun")
  lastNumber Int      @default(0) @map("nomor_terakhir")
  updatedAt  DateTime @updatedAt @map("diperbarui_pada") @db.Timestamptz

  @@map("urutan_penomoran")
}

model ExpeditionReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  regNumber      String   @unique @map("nomor_registrasi") @db.VarChar(40)
  letterId       String   @map("id_surat") @db.Uuid
  letter         IncomingLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  receiptDate    DateTime @map("tanggal_tanda_terima") @db.Date
  receiverName   String   @map("nama_penerima") @db.VarChar(150)
  signatureName  String?  @map("nama_tanda_tangan") @db.VarChar(150)
  note           String?  @map("catatan")
  createdBy      String   @map("dibuat_oleh") @db.Uuid
  creator        User     @relation("CreatedExpeditions", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@map("tanda_terima_ekspedisi")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("id_pengguna") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   @map("tipe") @db.VarChar(30)
  title         String   @map("judul") @db.VarChar(255)
  body          String?  @map("isi")
  referenceType String?  @map("tipe_referensi") @db.VarChar(50)
  referenceId   String?  @map("id_referensi") @db.Uuid
  isRead        Boolean  @default(false) @map("sudah_dibaca")
  readAt        DateTime? @map("dibaca_pada") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("dibuat_pada") @db.Timestamptz

  @@index([userId, isRead])
  @@map("notifikasi")
}
