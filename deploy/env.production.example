# Contoh variabel /opt/simpeg/.env (produksi).
# Semua nilai nyata diambil dari SSM Parameter Store oleh deploy/fetch-env.sh.
# JANGAN mengisi file ini dengan nilai asli di repo.

# --- Koneksi database -------------------------------------------------------
# Runtime (pooler/pg biasa). Untuk RDS: tanpa pgbouncer, SSL aktif.
DATABASE_URL=
# Dipakai Prisma CLI (migrate deploy). Boleh sama dengan DATABASE_URL.
DIRECT_URL=
# disable | require | no-verify. Produksi RDS memakai require.
DATABASE_SSL=
# Path CA bundle RDS di dalam image.
DATABASE_SSL_CA_FILE=
# Jumlah koneksi maksimum per proses backend.
DB_POOL_MAX=

# --- Autentikasi ------------------------------------------------------------
# Wajib di production: >=32 karakter, berbeda, bukan placeholder.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=
JWT_REFRESH_EXPIRES=

# --- Penyimpanan berkas -----------------------------------------------------
# s3 (produksi) | supabase | local
STORAGE_DRIVER=
S3_BUCKET=
AWS_REGION=
# Hanya untuk uji lokal; tolak local storage di production bila kosong.
ALLOW_LOCAL_STORAGE=

# --- Jaringan / proxy -------------------------------------------------------
# Kosong di production = tolak origin lintas situs (same-origin lewat proxy).
CORS_ORIGINS=
# Jumlah hop proxy yang dipercaya (Caddy -> Next -> Express = 1).
TRUST_PROXY=

# --- Batas dan aturan bisnis ------------------------------------------------
MAX_FILE_BYTES=
APEL_DEADLINE_TIME=
CHECKOUT_TIME_WEEKDAY=
CHECKOUT_TIME_FRIDAY=
LETTER_UNIT_CODE=
PENSION_BUP_AGE=
PROMOTION_MIN_YEARS=

# --- Variabel untuk interpolasi docker compose (dibaca shell, bukan container)
APP_DOMAIN=
ECR_REGISTRY=
TAG=
